<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Enables publishing via Native AOT compilation. -->
    <PublishAot>true</PublishAot>

    <!--
      Set to `false` to suppress warning IL3058, which is reported AOT compilation
      when dependent libraries do not explicitly declare AOT compatibility.
    -->
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Smdn.Devices.Mcp2221A" Version="[1.2.0,2.0.0)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />

    <!--
      Adds HidApi.Net (MIT License) as the USB HID backend provider.

      Note that although HidApi.Net claims to be AOT-compatible, the assembly
      metadata does not yet include `IsAotCompatible=true`.
      Consequently, warning IL3058 is reported during AOT compilation.
      Currently, HidApi.Net is the recommended backend for Native AOT scenarios.
    -->
    <PackageReference Include="Smdn.IO.UsbHid.Providers.HidApiDotNet" Version="1.1.0" />

    <!--
      Alternative USB HID backend providers (such as HIDSharp or LibUsbDotNet)
      can be used by changing the PackageReference.

      While the `Smdn.IO.UsbHid.Providers.*` packages themselves are AOT-compatible,
      most underlying backend libraries do not explicitly declare AOT compatibility.
      Therefore, using them with Native AOT may introduce runtime risks or additional
      compilation warnings.

      For more details, refer to the documentation:
      https://github.com/smdn/Smdn.Devices.Mcp2221A/tree/main/examples/Smdn.Devices.Mcp2221A/NativeAOT/README.md
      https://github.com/smdn/Smdn.Devices.Mcp2221A/tree/main/examples/Smdn.Devices.Mcp2221A/UsbHidBackendSamples.md
    -->
    <!--
    <PackageReference Include="Smdn.IO.UsbHid.Providers.HidApiDotNet" Version="1.1.0" />
    <PackageReference Include="Smdn.IO.UsbHid.Providers.LibUsbDotNet" Version="1.1.0" />
    <PackageReference Include="Smdn.IO.UsbHid.Providers.LibUsbDotNetV3" Version="1.1.0" />
    -->
  </ItemGroup>

</Project>
